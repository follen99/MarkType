{
  "name": "marktype-monorepo",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @marktype/desktop tauri dev",
    "dev:web": "pnpm --filter @marktype/web dev",
    "build": "pnpm --filter @marktype/desktop tauri build",
    "build:web": "pnpm --filter @marktype/web build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test && cargo test --workspace",
    "lint": "prettier --check . && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --all"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
